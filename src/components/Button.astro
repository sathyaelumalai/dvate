---
/**
 * Pill button link. `href` is a route relative to the base (for example routes.request),
 * or a full tel:, mailto: or https: link.
 */
import { withBase } from '../lib/url';

interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'outline-light';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', class: className, ...rest } = Astro.props;
---

<a class:list={['btn', `btn-${variant}`, className]} href={withBase(href)} {...rest}><slot /></a>

---
/**
 * Device Map (Vascular access page, A8). A dark, glowing schematic of a torso and arm
 * beside a tab list of four devices. Selecting a device draws its path along the vein,
 * starts a flow animation toward the tip and shows its details.
 * Without JavaScript, the PICC is shown and every panel is visible.
 * Logic: src/scripts/motion/a8-device-map.ts.
 */
import { devices } from '../data/details';

const selected = 'picc';

const bodyPath =
  'M134 96 C134 106 132 112 124 116 C96 124 70 136 60 162 C52 184 56 240 62 300 L70 440 L250 440 L254 300 C256 250 258 222 268 204 C300 196 420 196 600 198 C624 198 640 190 640 176 C640 162 624 152 600 152 C420 150 300 140 230 124 C196 116 176 112 166 106 L166 96 Z';
const veinPath =
  'M612 178 C520 177 400 176 300 172 C276 171 254 160 232 150 C210 141 186 140 174 152 C166 160 166 172 166 186 L166 232';
const heartPath =
  'M170 276 C146 260 140 240 152 232 C160 227 167 231 170 238 C173 231 180 227 188 232 C200 240 194 260 170 276 Z';

const paths: Record<string, string> = {
  piv: 'M560 177 L514 176.6',
  midline: 'M430 176.2 C384 175.4 340 174.4 300 172',
  picc: 'M430 176.2 C384 175.4 340 174.4 300 172 C276 171 254 160 232 150 C210 141 186 140 174 152 C166 160 166 172 166 186 L166 226',
  port: 'M100 178 C112 162 132 148 150 146 C162 146 166 156 166 170 L166 226',
};
// Where each device starts (insertion) and ends (tip), in the 660 x 440 viewBox.
const points: Record<string, { start: [number, number]; tip: [number, number] }> = {
  piv: { start: [560, 177], tip: [514, 176.6] },
  midline: { start: [430, 176.2], tip: [300, 172] },
  picc: { start: [430, 176.2], tip: [166, 226] },
  port: { start: [100, 178], tip: [166, 226] },
};
// Pointer shortcuts sit on each device's most distinctive spot.
const markerAt: Record<string, [number, number]> = {
  piv: [537, 177],
  midline: [300, 172],
  picc: [166, 226],
  port: [100, 178],
};
const VB_W = 660;
const VB_H = 440;
---

<div class="dm" data-device-map>
  <div class="dm-stage">
    <span class="dm-glow" aria-hidden="true"></span>
    <div class="dm-figure">
      <svg class="dm-svg" viewBox={`0 0 ${VB_W} ${VB_H}`} aria-hidden="true" focusable="false">
        <defs>
          <filter id="dm-blur" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3.5" result="b"></feGaussianBlur>
            <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
          </filter>
          <linearGradient id="dm-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.09"></stop>
            <stop offset="1" stop-color="#ffffff" stop-opacity="0.01"></stop>
          </linearGradient>
          <radialGradient id="dm-heart" cx="0.5" cy="0.4" r="0.6">
            <stop offset="0" stop-color="#ff6b66"></stop>
            <stop offset="1" stop-color="#c42620"></stop>
          </radialGradient>
        </defs>

        <!-- Body silhouette -->
        <circle cx="150" cy="58" r="38" fill="url(#dm-body)" stroke="rgba(184,203,226,0.28)" stroke-width="1.5"></circle>
        <path d={bodyPath} fill="url(#dm-body)" stroke="rgba(184,203,226,0.28)" stroke-width="1.5" stroke-linejoin="round"></path>

        <!-- Vein -->
        <path d={veinPath} fill="none" stroke="rgba(31,181,234,0.16)" stroke-width="12" stroke-linecap="round"></path>
        <path d={veinPath} fill="none" stroke="rgba(31,181,234,0.32)" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 6"></path>

        <!-- Heart, with a soft beat -->
        <g class="dm-heart">
          <path d={heartPath} fill="url(#dm-heart)" opacity="0.9"></path>
          <path d={heartPath} fill="none" stroke="#ff8f8a" stroke-width="1.2" opacity="0.6"></path>
        </g>

        <!-- Port reservoir -->
        <circle cx="100" cy="178" r="12" fill="rgba(31,181,234,0.12)" stroke="rgba(184,203,226,0.45)" stroke-width="1.5"></circle>

        <!-- Devices -->
        {
          devices.map((d) => (
            <g class:list={['dm-dev', { 'is-active': d.key === selected }]} data-device={d.key}>
              <path class="dm-path" d={paths[d.key]} pathLength="1" fill="none" stroke="#1FB5EA" stroke-width="6" stroke-linecap="round" filter="url(#dm-blur)" />
              <path class="dm-flow" d={paths[d.key]} pathLength="1" fill="none" stroke="#E6F8FF" stroke-width="2.4" stroke-linecap="round" />
              <circle class="dm-start" cx={points[d.key].start[0]} cy={points[d.key].start[1]} r="6.5" fill="#071528" stroke="#1FB5EA" stroke-width="3" />
              <g class="dm-tip" transform={`translate(${points[d.key].tip[0]} ${points[d.key].tip[1]})`}>
                <circle class="dm-tip-ring" r="14" fill="rgba(31,181,234,0.22)" />
                <circle r="5" fill="#ffffff" />
              </g>
            </g>
          ))
        }
      </svg>

      <!-- Pointer shortcuts on the figure. Keyboard users use the tab list. -->
      {
        devices.map((d) => (
          <button
            type="button"
            class="dm-marker"
            style={`left:${(markerAt[d.key][0] / VB_W) * 100}%;top:${(markerAt[d.key][1] / VB_H) * 100}%`}
            data-device-marker={d.key}
            tabindex="-1"
            aria-hidden="true"
          >
            <span />
          </button>
        ))
      }
    </div>
  </div>

  <div class="dm-side">
    <div class="dm-tabs" role="tablist" aria-label="Vascular access devices" aria-orientation="vertical">
      <span class="dm-indicator" aria-hidden="true" data-indicator></span>
      {
        devices.map((d) => (
          <button
            type="button"
            role="tab"
            class="dm-tab"
            id={`dm-tab-${d.key}`}
            aria-selected={d.key === selected ? 'true' : 'false'}
            aria-controls={`dm-panel-${d.key}`}
            tabindex={d.key === selected ? 0 : -1}
            data-device-button={d.key}
          >
            <span class="dm-tab-name">{d.name}</span>
            <span class="dm-tab-use">{d.use}</span>
          </button>
        ))
      }
    </div>

    <div class="dm-panels">
      {
        devices.map((d) => (
          <section class="dm-panel" id={`dm-panel-${d.key}`} role="tabpanel" aria-labelledby={`dm-tab-${d.key}`} data-device-panel={d.key}>
            <p class="dm-what" data-panel-item>
              {d.what}
            </p>
            <p class="dm-related" data-panel-item>
              Related DVATE services
            </p>
            <ul role="list" class="dm-chips">
              {d.services.map((s) => (
                <li data-panel-item>{s}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { prefersReducedMotion } from '../lib/motion';
  import { initDeviceMap } from '../scripts/motion/a8-device-map';
  document.querySelectorAll<HTMLElement>('[data-device-map]').forEach((root) => {
    initDeviceMap(root, !prefersReducedMotion());
  });
</script>

<style>
  .dm {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 8px;
    border-radius: clamp(24px, 3vw, 36px);
    background:
      radial-gradient(90% 80% at 20% 30%, rgba(31, 181, 234, 0.14), transparent 60%),
      var(--vein-deep);
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 1024px) {
    .dm {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }

  /* ---------- Figure ---------- */
  .dm-stage {
    position: relative;
    padding: clamp(20px, 4vw, 48px) clamp(12px, 3vw, 32px);
    align-self: center;
  }
  .dm-figure {
    position: relative;
  }
  .dm-glow {
    position: absolute;
    left: 15%;
    top: 30%;
    width: 50%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(229, 50, 45, 0.18), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }
  .dm-svg {
    position: relative;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .dm-heart {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: beat 1.6s ease-in-out infinite;
  }
  @keyframes beat {
    0%,
    40%,
    100% {
      transform: scale(1);
    }
    15% {
      transform: scale(1.08);
    }
    28% {
      transform: scale(1.03);
    }
  }
  .dm-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* Short bright dashes travel along the active device toward its tip. */
  .dm-flow {
    stroke-dasharray: 0.02 0.07;
    stroke-dashoffset: 0;
    opacity: 0.9;
    animation: flow 2.4s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -0.09;
    }
  }
  .dm-tip-ring {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: ring 2s var(--ease-out) infinite;
  }
  @keyframes ring {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  /* Once the script runs, only the selected device shows. */
  :global([data-device-map].is-ready) .dm-dev:not(.is-active) {
    opacity: 0;
  }

  .dm-marker {
    position: absolute;
    display: none;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  :global([data-device-map].is-ready) .dm-marker {
    display: block;
  }
  .dm-marker span {
    position: absolute;
    inset: 15px;
    border-radius: 50%;
    border: 2px solid rgba(184, 203, 226, 0.55);
    background: rgba(7, 21, 40, 0.6);
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms;
  }
  .dm-marker:hover span {
    transform: scale(1.35);
    border-color: var(--saline);
  }
  :global([data-device-map].is-ready) .dm-marker.is-active {
    display: none;
  }

  /* ---------- Tabs and panel ---------- */
  .dm-side {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: clamp(8px, 1.5vw, 16px);
    border-radius: clamp(18px, 2.4vw, 28px);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .dm-tabs {
    position: relative;
    display: grid;
    gap: 4px;
  }
  .dm-indicator {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    border-radius: 16px;
    background: linear-gradient(120deg, rgba(31, 181, 234, 0.24), rgba(31, 181, 234, 0.08));
    border: 1px solid rgba(31, 181, 234, 0.45);
    transition:
      transform 480ms var(--ease-out),
      height 480ms var(--ease-out);
    pointer-events: none;
  }
  .dm-tab {
    position: relative;
    display: grid;
    gap: 3px;
    padding: 14px 18px;
    border: 1px solid transparent;
    border-radius: 16px;
    background: none;
    color: var(--white);
    text-align: left;
    transition: background-color var(--t-fast);
  }
  .dm-tab:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  .dm-tab:focus-visible {
    outline: 2px solid var(--saline);
    outline-offset: 2px;
  }
  /* Without the sliding indicator (no JavaScript), mark the selected tab directly. */
  :global([data-device-map]:not(.is-ready)) .dm-tab[aria-selected='true'] {
    border-color: rgba(31, 181, 234, 0.45);
    background: rgba(31, 181, 234, 0.14);
  }
  .dm-tab-name {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .dm-tab-use {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--mist-on-dark);
  }

  .dm-panels {
    display: grid;
  }
  .dm-panel {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 18px 18px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  :global([data-device-map].is-ready) .dm-panel {
    grid-area: 1 / 1;
  }
  .dm-what {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--white);
  }
  .dm-related {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--mist-on-dark);
  }
  .dm-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -4px 0 0;
  }
  .dm-chips li {
    padding: 7px 12px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.875rem;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .dm-heart,
    .dm-flow,
    .dm-tip-ring {
      animation: none;
    }
  }
</style>

---
/**
 * Device Map (Vascular access page, A8). A dark, glowing schematic of a torso and arm
 * beside a tab list of four devices. Selecting a device draws its path along the vein,
 * starts a flow animation toward the tip and shows its details.
 * Without JavaScript, the PICC is shown and every panel is visible.
 * Logic: src/scripts/motion/a8-device-map.ts.
 */
import { devices } from '../data/details';

const selected = 'picc';

// A symmetrical, front-facing upper body (viewBox 400 x 500), mirrored around x = 200.
const bodyPath =
  'M186 98 C186 110 184 116 176 120 C160 126 132 130 118 140 C100 150 94 166 96 186 C94 230 90 262 90 290 C88 320 84 356 84 388 C80 398 78 414 82 428 C86 440 98 442 104 432 C108 420 106 402 106 390 C108 360 112 324 114 292 C116 262 120 226 128 200 C132 240 136 290 140 330 C142 380 136 440 134 500 L266 500 C264 440 258 380 260 330 C264 290 268 240 272 200 C280 226 284 262 286 292 C288 324 292 360 294 390 C294 402 292 420 296 432 C302 442 314 440 318 428 C322 414 320 398 316 388 C316 356 312 320 310 290 C310 262 306 230 304 186 C306 166 300 150 282 140 C268 130 240 126 224 120 C216 116 214 110 214 98 Z';
// Collarbones and a faint sternum line.
const detailPath = 'M188 136 C170 140 150 141 132 146 M212 136 C230 140 250 141 268 146 M200 150 L200 268';
// Basilic vein up the inner arm, then subclavian vein to the superior vena cava.
const veinPath =
  'M100 382 C102 350 106 300 110 268 C113 244 118 220 126 200 C134 180 150 160 168 154 C182 150 190 156 191 172 L192 232';
const heartPath =
  'M208 272 C188 259 182 242 192 235 C199 231 205 234 208 240 C211 234 217 231 224 235 C234 242 228 259 208 272 Z';

const paths: Record<string, string> = {
  piv: 'M101 364 L104 328',
  midline: 'M109 276 C112 252 116 228 124 206',
  picc: 'M109 276 C112 252 116 228 124 206 C132 184 150 160 168 154 C182 150 190 156 191 172 L192 226',
  port: 'M158 184 C164 172 174 162 182 160 C189 160 191 166 191 176 L192 226',
};
// Where each device starts (insertion) and ends (tip).
const points: Record<string, { start: [number, number]; tip: [number, number] }> = {
  piv: { start: [101, 364], tip: [104, 328] },
  midline: { start: [109, 276], tip: [124, 206] },
  picc: { start: [109, 276], tip: [192, 226] },
  port: { start: [158, 184], tip: [192, 226] },
};
// Pointer shortcuts sit on each device's most distinctive spot.
const markerAt: Record<string, [number, number]> = {
  piv: [102, 346],
  midline: [124, 206],
  picc: [192, 226],
  port: [158, 184],
};
const VB_W = 400;
const VB_H = 500;
---

<div class="dm" data-device-map>
  <div class="dm-stage">
    <span class="dm-glow" aria-hidden="true"></span>
    <div class="dm-figure">
      <svg class="dm-svg" viewBox={`0 0 ${VB_W} ${VB_H}`} aria-hidden="true" focusable="false">
        <defs>
          <filter id="dm-blur" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3.5" result="b"></feGaussianBlur>
            <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
          </filter>
          <linearGradient id="dm-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.09"></stop>
            <stop offset="1" stop-color="#ffffff" stop-opacity="0.01"></stop>
          </linearGradient>
          <linearGradient id="dm-fade-g" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0.72" stop-color="#fff"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
          </linearGradient>
          <mask id="dm-fade" maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="500">
            <rect width="400" height="500" fill="url(#dm-fade-g)"></rect>
          </mask>
          <radialGradient id="dm-heart" cx="0.5" cy="0.4" r="0.6">
            <stop offset="0" stop-color="#ff6b66"></stop>
            <stop offset="1" stop-color="#c42620"></stop>
          </radialGradient>
        </defs>

        <!-- Body silhouette, fading out toward the bottom -->
        <g mask="url(#dm-fade)">
          <ellipse cx="200" cy="60" rx="33" ry="40" fill="url(#dm-body)" stroke="rgba(184,203,226,0.3)" stroke-width="1.5"></ellipse>
          <path d={bodyPath} fill="url(#dm-body)" stroke="rgba(184,203,226,0.3)" stroke-width="1.5" stroke-linejoin="round"></path>
          <path d={detailPath} fill="none" stroke="rgba(184,203,226,0.16)" stroke-width="1.3" stroke-linecap="round"></path>
        </g>

        <!-- Vein -->
        <path d={veinPath} fill="none" stroke="rgba(31,181,234,0.16)" stroke-width="10" stroke-linecap="round"></path>
        <path d={veinPath} fill="none" stroke="rgba(31,181,234,0.32)" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 6"></path>

        <!-- Heart, with a soft beat -->
        <g class="dm-heart">
          <path d={heartPath} fill="url(#dm-heart)" opacity="0.9"></path>
          <path d={heartPath} fill="none" stroke="#ff8f8a" stroke-width="1.2" opacity="0.6"></path>
        </g>

        <!-- Port reservoir -->
        <circle cx="158" cy="184" r="10" fill="rgba(31,181,234,0.12)" stroke="rgba(184,203,226,0.45)" stroke-width="1.5"></circle>

        <!-- Devices -->
        {
          devices.map((d) => (
            <g class:list={['dm-dev', { 'is-active': d.key === selected }]} data-device={d.key}>
              <path class="dm-path" d={paths[d.key]} pathLength="1" fill="none" stroke="#1FB5EA" stroke-width="5" stroke-linecap="round" filter="url(#dm-blur)" />
              <path class="dm-flow" d={paths[d.key]} pathLength="1" fill="none" stroke="#E6F8FF" stroke-width="2.4" stroke-linecap="round" />
              <circle class="dm-start" cx={points[d.key].start[0]} cy={points[d.key].start[1]} r="5.5" fill="#071528" stroke="#1FB5EA" stroke-width="2.5" />
              <g class="dm-tip" transform={`translate(${points[d.key].tip[0]} ${points[d.key].tip[1]})`}>
                <circle class="dm-tip-ring" r="12" fill="rgba(31,181,234,0.22)" />
                <circle r="4.5" fill="#ffffff" />
              </g>
            </g>
          ))
        }
      </svg>

      <!-- Pointer shortcuts on the figure. Keyboard users use the tab list. -->
      {
        devices.map((d) => (
          <button
            type="button"
            class="dm-marker"
            style={`left:${(markerAt[d.key][0] / VB_W) * 100}%;top:${(markerAt[d.key][1] / VB_H) * 100}%`}
            data-device-marker={d.key}
            tabindex="-1"
            aria-hidden="true"
          >
            <span />
          </button>
        ))
      }
    </div>
  </div>

  <div class="dm-side">
    <div class="dm-tabs" role="tablist" aria-label="Vascular access devices" aria-orientation="vertical">
      <span class="dm-indicator" aria-hidden="true" data-indicator></span>
      {
        devices.map((d) => (
          <button
            type="button"
            role="tab"
            class="dm-tab"
            id={`dm-tab-${d.key}`}
            aria-selected={d.key === selected ? 'true' : 'false'}
            aria-controls={`dm-panel-${d.key}`}
            tabindex={d.key === selected ? 0 : -1}
            data-device-button={d.key}
          >
            <span class="dm-tab-name">{d.name}</span>
            <span class="dm-tab-use">{d.use}</span>
          </button>
        ))
      }
    </div>

    <div class="dm-panels">
      {
        devices.map((d) => (
          <section class="dm-panel" id={`dm-panel-${d.key}`} role="tabpanel" aria-labelledby={`dm-tab-${d.key}`} data-device-panel={d.key}>
            <p class="dm-what" data-panel-item>
              {d.what}
            </p>
            <p class="dm-related" data-panel-item>
              Related DVATE services
            </p>
            <ul role="list" class="dm-chips">
              {d.services.map((s) => (
                <li data-panel-item>{s}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { prefersReducedMotion } from '../lib/motion';
  import { initDeviceMap } from '../scripts/motion/a8-device-map';
  document.querySelectorAll<HTMLElement>('[data-device-map]').forEach((root) => {
    initDeviceMap(root, !prefersReducedMotion());
  });
</script>

<style>
  .dm {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 8px;
    border-radius: clamp(24px, 3vw, 36px);
    background:
      radial-gradient(90% 80% at 20% 30%, rgba(31, 181, 234, 0.14), transparent 60%),
      var(--vein-deep);
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 900px) {
    .dm {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }

  /* ---------- Figure ---------- */
  .dm-stage {
    position: relative;
    padding: clamp(20px, 4vw, 48px) clamp(12px, 3vw, 32px);
    align-self: center;
  }
  .dm-figure {
    position: relative;
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
  }
  .dm-glow {
    position: absolute;
    left: 25%;
    top: 25%;
    width: 50%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(229, 50, 45, 0.18), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }
  .dm-svg {
    position: relative;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* The heart glows very gently; nothing beats or shakes. */
  .dm-heart {
    animation: glow 4s ease-in-out infinite;
  }
  @keyframes glow {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }
  .dm-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* Short bright dashes travel along the active device toward its tip. */
  .dm-flow {
    stroke-dasharray: 0.02 0.07;
    stroke-dashoffset: 0;
    opacity: 0.9;
    animation: flow 4s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -0.09;
    }
  }
  .dm-tip-ring {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: ring 3s ease-out infinite;
  }
  @keyframes ring {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  /* Once the script runs, only the selected device shows. */
  :global([data-device-map].is-ready) .dm-dev:not(.is-active) {
    opacity: 0;
  }

  .dm-marker {
    position: absolute;
    display: none;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  :global([data-device-map].is-ready) .dm-marker {
    display: block;
  }
  .dm-marker span {
    position: absolute;
    inset: 15px;
    border-radius: 50%;
    border: 2px solid rgba(184, 203, 226, 0.55);
    background: rgba(7, 21, 40, 0.6);
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms;
  }
  .dm-marker:hover span {
    transform: scale(1.35);
    border-color: var(--saline);
  }
  :global([data-device-map].is-ready) .dm-marker.is-active {
    display: none;
  }

  /* ---------- Tabs and panel ---------- */
  .dm-side {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: clamp(8px, 1.5vw, 16px);
    border-radius: clamp(18px, 2.4vw, 28px);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .dm-tabs {
    position: relative;
    display: grid;
    gap: 4px;
  }
  .dm-indicator {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    border-radius: 16px;
    background: linear-gradient(120deg, rgba(31, 181, 234, 0.24), rgba(31, 181, 234, 0.08));
    border: 1px solid rgba(31, 181, 234, 0.45);
    transition:
      transform 480ms var(--ease-out),
      height 480ms var(--ease-out);
    pointer-events: none;
  }
  .dm-tab {
    position: relative;
    display: grid;
    gap: 3px;
    padding: 14px 18px;
    border: 1px solid transparent;
    border-radius: 16px;
    background: none;
    color: var(--white);
    text-align: left;
    transition: background-color var(--t-fast);
  }
  .dm-tab:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  .dm-tab:focus-visible {
    outline: 2px solid var(--saline);
    outline-offset: 2px;
  }
  /* Without the sliding indicator (no JavaScript), mark the selected tab directly. */
  :global([data-device-map]:not(.is-ready)) .dm-tab[aria-selected='true'] {
    border-color: rgba(31, 181, 234, 0.45);
    background: rgba(31, 181, 234, 0.14);
  }
  .dm-tab-name {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .dm-tab-use {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--mist-on-dark);
  }

  .dm-panels {
    display: grid;
  }
  .dm-panel {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 18px 18px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  :global([data-device-map].is-ready) .dm-panel {
    grid-area: 1 / 1;
  }
  .dm-what {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--white);
  }
  .dm-related {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--mist-on-dark);
  }
  .dm-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -4px 0 0;
  }
  .dm-chips li {
    padding: 7px 12px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.875rem;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .dm-heart,
    .dm-flow,
    .dm-tip-ring {
      animation: none;
    }
  }
</style>

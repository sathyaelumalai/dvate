---
/**
 * Site header. Transparent over the dark hero or page header, solid white once the
 * visitor scrolls past it (A10, src/scripts/header.ts). Without JavaScript it stays solid.
 */
import Wordmark from './Wordmark.astro';
import { services } from '../data/services';
import { directors, telHref } from '../data/site';
import { withBase, routes } from '../lib/url';
import { serviceIcons } from '../data/icons';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (route: string) => path === withBase(route);
const inServices = services.some((s) => isCurrent(s.route));

const links = [
  { label: 'Education', route: routes.education },
  { label: 'Who we serve', route: routes.whoWeServe },
  { label: 'About', route: routes.about },
];
---

<header class="site-header" data-header>
  <div class="header-bar wrap">
    <a class="brand" href={withBase(routes.home)} aria-label="DVATE home">
      <Wordmark />
    </a>

    <nav class="main-nav" aria-label="Main">
      <ul role="list" class="nav-list">
        <li class="has-sub" data-dropdown>
          <button
            class:list={['nav-link', 'sub-toggle', { 'is-current': inServices }]}
            type="button"
            aria-expanded="false"
            aria-controls="sub-services"
          >
            Services
            <svg class="chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="2"></path>
            </svg>
          </button>
          <div class="sub-menu" id="sub-services">
            <ul role="list">
              {
                services.map((s) => (
                  <li>
                    <a
                      href={withBase(s.route)}
                      aria-current={isCurrent(s.route) ? 'page' : undefined}
                    >
                      <span class:list={['sub-icon', `sub-icon-${s.key}`]} aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          width="22"
                          height="22"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          set:html={serviceIcons[s.key]}
                        />
                      </span>
                      <span class="sub-text">
                        <span class="sub-name">{s.name}</span>
                        <span class="sub-line">{s.menuLine}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a
                class="nav-link"
                href={withBase(l.route)}
                aria-current={isCurrent(l.route) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="btn btn-primary btn-small header-cta"
      href={withBase(routes.contact)}
      aria-current={isCurrent(routes.contact) ? 'page' : undefined}
    >
      Contact
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span class="menu-label">Menu</span>
    </button>
  </div>

  <div class="mobile-menu theme-dark" id="mobile-menu" data-mobile-menu>
    <nav class="mobile-inner wrap" aria-label="Mobile">
      <p class="mobile-group">Services</p>
      <ul role="list" class="mobile-list mobile-services">
        {
          services.map((s) => (
            <li>
              <a href={withBase(s.route)} aria-current={isCurrent(s.route) ? 'page' : undefined}>
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
      <ul role="list" class="mobile-list">
        {
          links.map((l) => (
            <li>
              <a href={withBase(l.route)} aria-current={isCurrent(l.route) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary mobile-cta" href={withBase(routes.contact)}>Contact</a>
      <div class="mobile-call">
        {
          Object.values(directors).map((d) => (
            <a class="call-card" href={telHref(d.phone)}>
              <span class="call-name">
                Call {d.name.split(' ')[0]}, {d.title.replace('Director of ', '')}
              </span>
              <span class="call-number">{d.phone}</span>
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  import '../scripts/header';
  import '../scripts/nav';
</script>

<style>
  /* A floating glass pill. Without JavaScript it stays in its solid (light) state. */
  .site-header {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 100;
    color: var(--vein);
    pointer-events: none;
  }
  .header-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 20px;
    height: calc(var(--header-h) - 20px);
    padding-inline: 10px 10px;
    padding-left: 20px;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: var(--glass-light);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
    box-shadow: 0 10px 40px -12px rgba(11, 31, 58, 0.25);
    pointer-events: auto;
    transition:
      background-color var(--t-header) ease,
      border-color var(--t-header) ease,
      box-shadow var(--t-header) ease,
      color var(--t-header) ease;
  }
  /* Over the dark hero, with JavaScript running: a dark, see-through pill. */
  :global(.js) .site-header:not(.is-solid),
  .site-header.menu-open {
    color: var(--white);
  }
  :global(.js) .site-header:not(.is-solid) .header-bar,
  .site-header.menu-open .header-bar {
    background: rgba(11, 31, 58, 0.35);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: none;
  }
  :global(.js) .site-header:not(.is-solid) .brand :global(.wm-ate),
  .site-header.menu-open .brand :global(.wm-ate) {
    color: var(--saline);
  }

  .brand {
    color: inherit;
    text-decoration: none;
    margin-right: auto;
    border-radius: 8px;
  }
  .site-header :focus-visible {
    outline-color: var(--vein-2);
  }
  :global(.js) .site-header:not(.is-solid) :focus-visible,
  .site-header.menu-open :focus-visible {
    outline-color: var(--saline);
  }

  /* ---------- Desktop nav ---------- */
  .main-nav,
  .header-cta {
    display: none;
    white-space: nowrap;
  }
  @media (min-width: 1180px) {
    .main-nav {
      display: block;
    }
    .header-cta {
      display: inline-flex;
    }
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 14px;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: inherit;
    font-weight: 500;
    font-size: 0.9688rem;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color var(--t-fast);
  }
  .nav-link:hover {
    color: inherit;
    background: rgba(127, 150, 180, 0.16);
  }
  .nav-link[aria-current='page'],
  .nav-link.is-current {
    background: rgba(127, 150, 180, 0.18);
  }
  .chev {
    transition: transform var(--t-fast);
  }
  .has-sub {
    position: relative;
  }
  .sub-toggle[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }

  /* Dropdown: a glass panel that matches the header's current state. */
  .sub-menu {
    position: absolute;
    top: calc(100% + 18px);
    left: 50%;
    width: min(420px, calc(100vw - 32px));
    padding: 8px;
    border: 1px solid var(--rule);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.985);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    box-shadow: 0 24px 60px -20px rgba(11, 31, 58, 0.35);
    color: var(--vein);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -8px) scale(0.97);
    transform-origin: 50% 0;
    transition:
      opacity 180ms ease,
      transform 220ms var(--ease-out),
      visibility 0s linear 220ms;
  }
  /* Invisible bridge so the pointer can travel from the button into the panel. */
  .sub-menu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -20px;
    height: 20px;
  }
  :global(.js) .site-header:not(.is-solid) .sub-menu {
    background: rgba(9, 24, 46, 0.96);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.6);
    color: var(--white);
  }
  .sub-menu ul {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .has-sub.open .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) scale(1);
    transition:
      opacity 180ms ease,
      transform 260ms var(--ease-out);
  }
  @media (hover: hover) {
    .has-sub:hover .sub-menu {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0) scale(1);
      transition:
        opacity 180ms ease,
        transform 260ms var(--ease-out);
    }
  }
  .sub-menu a {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 12px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--t-fast);
  }
  .sub-menu a:hover,
  .sub-menu a[aria-current='page'] {
    background: rgba(127, 150, 180, 0.14);
  }
  .sub-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: var(--white);
    color: var(--saline-text);
  }
  .sub-icon-transfusion {
    color: var(--artery-text);
  }
  :global(.js) .site-header:not(.is-solid) .sub-icon {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    color: var(--saline);
  }
  :global(.js) .site-header:not(.is-solid) .sub-icon-transfusion {
    color: #ff6b66;
  }
  /* min-width: 0 lets the text column shrink and wrap inside the flex row (Safari). */
  .sub-text {
    flex: 1 1 auto;
    min-width: 0;
    padding-top: 1px;
  }
  .sub-name {
    display: block;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .sub-line {
    display: block;
    margin-top: 2px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--steel);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  :global(.js) .site-header:not(.is-solid) .sub-line {
    color: var(--mist-on-dark);
  }

  /* ---------- Mobile toggle ---------- */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 8px 16px;
    border: 1.5px solid currentColor;
    border-radius: var(--r-pill);
    background: none;
    color: inherit;
    font-weight: 600;
  }
  .menu-icon {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .menu-icon span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--t-fast);
  }
  .menu-toggle[aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  @media (min-width: 1180px) {
    .menu-toggle {
      display: none;
    }
  }

  /* ---------- Mobile menu: full screen, slides down ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: calc(var(--header-h) + 12px);
    pointer-events: auto;
    overflow-y: auto;
    visibility: hidden;
    transform: translateY(-100%);
    transition:
      transform 280ms var(--ease-out),
      visibility 0s linear 280ms;
  }
  .mobile-menu.is-open {
    visibility: visible;
    transform: none;
    transition: transform 280ms var(--ease-out);
  }
  @media (min-width: 1180px) {
    .mobile-menu {
      display: none;
    }
  }
  .mobile-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: calc(100dvh - var(--header-h));
    padding-block: 16px 32px;
  }
  .mobile-group {
    color: var(--mist-on-dark);
    font-size: var(--fs-small);
    margin-bottom: -12px;
  }
  .mobile-list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--rule-on-dark);
  }
  .mobile-list + .mobile-list {
    border-top: 0;
    margin-top: -20px;
  }
  .mobile-list a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-on-dark);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    font-size: 1.75rem;
    text-decoration: none;
  }
  .mobile-list a[aria-current='page'] {
    color: var(--saline);
  }
  .mobile-cta {
    align-self: flex-start;
  }
  .mobile-call {
    margin-top: auto;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 560px) {
    .mobile-call {
      grid-template-columns: 1fr 1fr;
    }
  }
  .call-card {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--r-panel);
    background: var(--vein-2);
    color: var(--white);
    text-decoration: none;
  }
  .call-card:hover {
    color: var(--white);
    background: #1b3d6c;
  }
  .call-name {
    font-size: var(--fs-small);
    color: var(--mist-on-dark);
  }
  .call-number {
    font-weight: 600;
    font-size: 1.25rem;
  }
</style>

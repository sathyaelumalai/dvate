---
/** Up to four real figures. Renders nothing until proofNumbers has items in src/data/site.ts. */
import { proofNumbers } from '../../data/site';

const items = proofNumbers.slice(0, 4);
---

{
  items.length > 0 && (
    <section class="proof section theme-bone" aria-labelledby="proof-title">
      <div class="wrap">
        <h2 id="proof-title" class="visually-hidden">DVATE in numbers</h2>
        <ul role="list" class="proof-list">
          {items.map((n) => (
            <li>
              <span class="proof-value tabular">{n.value}</span>
              <span class="proof-label">{n.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .proof-list {
    display: grid;
    gap: 32px;
    margin: 0;
  }
  @media (min-width: 640px) {
    .proof-list {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
  .proof-list li {
    display: grid;
    gap: 6px;
    padding-top: 18px;
    border-top: 4px solid var(--saline);
  }
  .proof-value {
    font-size: clamp(2.75rem, 2rem + 2.5vw, 4rem);
    font-weight: 640;
    line-height: 1;
  }
  .proof-label {
    color: var(--steel);
  }
</style>

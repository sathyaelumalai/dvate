---
/** Certifications and licenses. Renders nothing until credentials has items in src/data/site.ts. */
import { credentials } from '../../data/site';
---

{
  credentials.length > 0 && (
    <section class="creds theme-light" aria-labelledby="creds-title">
      <div class="wrap creds-inner">
        <h2 id="creds-title" class="creds-title">Credentials</h2>
        <ul role="list" class="creds-list">
          {credentials.map((c) => (
            <li>
              <strong>{c.label}</strong>
              {c.detail && <span>{c.detail}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .creds {
    padding-block: 40px;
    border-block: 1px solid var(--rule);
  }
  .creds-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 40px;
  }
  .creds-title {
    font-family: var(--font-body);
    font-stretch: 100%;
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--steel);
  }
  .creds-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 0;
  }
  .creds-list li {
    display: grid;
  }
  .creds-list strong {
    font-family: var(--font-display);
    font-stretch: var(--stretch-heading);
    font-size: 1.25rem;
  }
  .creds-list span {
    font-size: var(--fs-small);
    color: var(--steel);
  }
</style>

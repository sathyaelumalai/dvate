---
/** Testimonials from facility staff. Renders nothing until testimonials has items in src/data/site.ts. */
import { testimonials } from '../../data/site';
---

{
  testimonials.length > 0 && (
    <section class="quotes section theme-light" aria-labelledby="quotes-title">
      <div class="wrap">
        <h2 id="quotes-title" class="quotes-title">What facilities say.</h2>
        <ul role="list" class="quotes-list">
          {testimonials.map((t) => (
            <li>
              <figure>
                <blockquote>
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>
                    {t.title}, {t.facilityType}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .quotes-title {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .quotes-list {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  @media (min-width: 900px) {
    .quotes-list {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }
  figure {
    display: grid;
    gap: 20px;
    height: 100%;
    margin: 0;
    padding: clamp(24px, 3vw, 36px);
    background: var(--bone);
    border-radius: var(--r-panel);
    border-left: 6px solid var(--artery);
  }
  blockquote p {
    font-size: var(--fs-lede);
    line-height: 1.5;
  }
  figcaption {
    display: grid;
    gap: 2px;
  }
  figcaption span {
    color: var(--steel);
  }
</style>

---
/** The DVATE mark: a blood drop inside a catheter loop with its hub. Decorative. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className } = Astro.props;
---

<svg
  class:list={['drop-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 44 44"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="22" cy="23" r="18.5" fill="none" stroke="#1FB5EA" stroke-width="3.4"></circle>
  <circle cx="9" cy="10" r="3.8" fill="#1FB5EA"></circle>
  <path d="M22 8.5s-9.5 11.6-9.5 17.6a9.5 9.5 0 0 0 19 0C31.5 20.1 22 8.5 22 8.5z" fill="#E5322D"></path>
  <path
    d="M17.6 24.5c.3-2.6 2-5.4 3.3-7.2"
    stroke="#FF9A94"
    stroke-width="2.2"
    stroke-linecap="round"
    fill="none"></path>
</svg>

---
/** Home hero (6.1). Dark, full height on desktop, with the A1 line and drop. */
import LineAndDrop from './LineAndDrop.astro';
import Button from './Button.astro';
import TeamPhoto from './proof/TeamPhoto.astro';
import { promise } from '../data/content';
import { routes } from '../lib/url';

const headline = 'Vascular access, transfusion and infusion care at the bedside.';
const words = headline.split(' ');
const chips = [
  { label: 'PICC lines and midlines', pos: 'c1' },
  { label: 'Bedside transfusions', pos: 'c2' },
  { label: 'Infusion therapy', pos: 'c3' },
  { label: 'Staff education', pos: 'c4' },
];
---

<section class="hero theme-dark" data-hero aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <span class="glow glow-a"></span>
    <span class="glow glow-b"></span>
    <span class="grid"></span>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-pill"><span class="pulse" aria-hidden="true"></span>High-level care, brought to the bedside</p>
      <h1 id="hero-title" class="hero-title">
        {
          words.map((w, i) => (
            <>
              <span class="hl-w">
                <span style={`--i:${i}`}>{w}</span>
              </span>{' '}
            </>
          ))
        }
      </h1>
      <p class="lede hero-lede hero-fade" style="--d: 0.55s">
        DVATE nurses come to your facility to place PICC lines, midlines and ultrasound-guided IVs, run non-emergent
        transfusions and deliver infusion therapy. Your residents stay in their own beds.
      </p>
      <p class="hero-promise hero-fade" style="--d: 0.7s">
        {promise.map((p) => <span>{p}</span>)}
      </p>
      <div class="btn-row hero-fade" style="--d: 0.85s">
        <Button href={routes.request}>Request service</Button>
        <Button href="#services" variant="outline-light">See our services</Button>
      </div>
      <TeamPhoto class="hero-photo" />
    </div>

    <div class="hero-art">
      <span class="art-halo" aria-hidden="true"></span>
      <LineAndDrop id="hero-lad" />
      <ul role="list" class="chips" aria-hidden="true">
        {chips.map((c, i) => <li class:list={['chip', c.pos]} style={`--c:${i}`}>{c.label}</li>)}
      </ul>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(48px, 7vw, 96px));
    padding-bottom: clamp(64px, 8vw, 112px);
    background: var(--vein-deep);
    isolation: isolate;
  }
  @media (min-width: 1024px) {
    .hero {
      min-height: max(700px, 100svh);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  /* Background: two soft glows and a faint dot grid that fades out toward the edges. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }
  .glow-a {
    width: 62vw;
    height: 62vw;
    max-width: 900px;
    max-height: 900px;
    right: -18vw;
    top: -20vw;
    background: radial-gradient(circle, rgba(31, 181, 234, 0.32), transparent 65%);
  }
  .glow-b {
    width: 44vw;
    height: 44vw;
    max-width: 640px;
    max-height: 640px;
    right: 8vw;
    bottom: -22vw;
    background: radial-gradient(circle, rgba(229, 50, 45, 0.22), transparent 65%);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(184, 203, 226, 0.16) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse at 70% 40%, #000 10%, transparent 70%);
  }

  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 40px;
    }
  }
  .hero-copy {
    display: grid;
    gap: 26px;
    justify-items: start;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px 7px 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.05);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--mist-on-dark);
  }
  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--artery);
  }
  .pulse {
    box-shadow: 0 0 0 4px rgba(229, 50, 45, 0.18);
  }

  .hero-title {
    max-width: 15ch;
  }
  .hl-w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .hl-w > span {
    display: inline-block;
  }
  .hero-lede {
    max-width: 38rem;
    color: var(--mist-on-dark);
  }
  .hero-promise {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4em;
    font-weight: 600;
    font-size: var(--fs-promise);
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--white);
    max-width: none;
  }

  /* Art: the line and drop, a soft halo, and four glass chips that drift gently. */
  .hero-art {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: 12px;
  }
  .hero-art :global(.lad) {
    position: relative;
    z-index: 1;
    max-width: min(340px, 78%);
  }
  @media (min-width: 1024px) {
    .hero-art :global(.lad) {
      max-width: 470px;
    }
  }
  .art-halo {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(229, 50, 45, 0.28), rgba(31, 181, 234, 0.08) 45%, transparent 70%);
    filter: blur(20px);
    animation: breathe 6s ease-in-out infinite;
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .art-halo {
      animation: none;
    }
  }
  .chips {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    pointer-events: none;
  }
  .chip {
    position: absolute;
    padding: 9px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--r-pill);
    background: rgba(20, 50, 92, 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--white);
  }
  .chip::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    border-radius: 50%;
    background: var(--saline);
    vertical-align: 1px;
  }
  .c1 {
    top: 8%;
    left: -4%;
  }
  .c2 {
    top: 44%;
    left: -22%;
  }
  .c2::before {
    background: var(--artery);
  }
  .c3 {
    bottom: -1%;
    left: -10%;
  }
  .c4 {
    bottom: 12%;
    right: -10%;
  }
  @media (max-width: 1023px) {
    .chips {
      display: none;
    }
  }

  /* A1 headline reveal from first paint: masked slide-up, staggered 0.08s. */
  :global(.motion-ok) .hl-w > span {
    animation: hl-rise 1s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--i) * 0.07s);
  }
  :global(.motion-ok) .chip {
    animation: fade-up 0.8s var(--ease-out) both;
    animation-delay: calc(1.6s + var(--c, 0) * 0.12s);
  }
  :global(.motion-ok) .hero-fade,
  :global(.motion-ok) .hero-pill {
    animation: fade-up 0.9s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes hl-rise {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

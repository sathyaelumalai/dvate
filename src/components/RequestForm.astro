---
/**
 * Service request form (from legacy-v1/contact.html). Posts to site.formEndpoint, or falls
 * back to a mailto: link to the primary contact when the endpoint is empty.
 * Logic: src/scripts/form.ts. Success and error motion: A9.
 */
import { site, primaryContact } from '../data/site';

const facilityTypes = [
  'Skilled nursing or long-term care',
  'Assisted living or memory care',
  'LTACH or inpatient rehab',
  'Home health or hospice agency',
  'Physician group or clinic',
  'Hospital',
  'Other',
];
const serviceOptions = [
  'PICC line',
  'Midline',
  'Ultrasound-guided IV',
  'Port care',
  'De-clotting or dressing changes',
  'Blood draws',
  'Transfusion',
  'Infusion therapy',
  'Education',
  'Not sure yet',
];
const volumes = ['1 to 5', '6 to 15', '16 to 40', 'More than 40', 'Not sure'];
const dropPath = 'M22 8.5s-9.5 11.6-9.5 17.6a9.5 9.5 0 0 0 19 0C31.5 20.1 22 8.5 22 8.5z';
---

<div class="form-card">
  <h2 class="form-title">Service request</h2>
  <div class="notice form-notice">
    <p>
      Please do not include patient names or health information in this form. Our clinical team will collect order
      details securely when we follow up.
    </p>
  </div>

  <form
    id="request-form"
    data-request-form
    data-endpoint={site.formEndpoint}
    data-mailto={primaryContact.email}
    data-phone={primaryContact.phone}
    novalidate
  >
    <div class="form-grid">
      <div class="field full">
        <label for="facility">Facility or organization name</label>
        <input id="facility" name="facility" autocomplete="organization" required />
      </div>
      <fieldset class="field full">
        <legend>Facility type <span class="hint">(optional)</span></legend>
        <div class="chips">
          {
            facilityTypes.map((t) => (
              <label class="choice">
                <input type="radio" name="facility_type" value={t} />
                <span class="choice-ui">{t}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="field">
        <label for="location">City and state</label>
        <input id="location" name="location" autocomplete="address-level2" required />
      </div>
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="role">Your role <span class="hint">(optional)</span></label>
        <input id="role" name="role" autocomplete="organization-title" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" required />
      </div>
      <fieldset class="field full">
        <legend>Services you are interested in <span class="hint">(optional)</span></legend>
        <div class="chips">
          {
            serviceOptions.map((s) => (
              <label class="choice">
                <input type="checkbox" name="services" value={s} />
                <span class="choice-ui">
                  <svg class="choice-check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {s}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="field full">
        <legend>Expected procedures per month <span class="hint">(optional)</span></legend>
        <div class="chips">
          {
            volumes.map((v) => (
              <label class="choice">
                <input type="radio" name="volume" value={v} />
                <span class="choice-ui">{v}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="field full">
        <legend>Best way to reach you</legend>
        <div class="segment">
          {
            ['Phone', 'Email', 'Either'].map((v, i) => (
              <label class="segment-option">
                <input type="radio" name="contact_pref" value={v} checked={i === 0} />
                <span class="segment-ui">{v}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="field full">
        <label for="message">Anything else we should know? <span class="hint">(optional)</span></label>
        <textarea id="message" name="message" rows="5"></textarea>
      </div>
      <div class="gotcha" aria-hidden="true">
        <label for="gotcha">Leave this field empty</label>
        <input id="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <div class="submit-row">
      <button class="btn btn-primary submit" type="submit" data-submit>Send request</button>
      <svg class="submit-drop" viewBox="10 6 24 32" width="48" height="64" aria-hidden="true" focusable="false" data-submit-drop>
        <defs>
          <clipPath id="submit-fill-clip">
            <rect x="10" y="6" width="24" height="32" class="submit-fill-rect"></rect>
          </clipPath>
        </defs>
        <path d={dropPath} fill="rgba(229, 50, 45, 0.12)" stroke="#E5322D" stroke-width="0.8"></path>
        <path d={dropPath} fill="#E5322D" clip-path="url(#submit-fill-clip)"></path>
      </svg>
    </div>
    <p id="form-status" class="form-status" role="status" aria-live="polite" data-form-status></p>
  </form>
</div>

<script>
  import '../scripts/form';
</script>

<style>
  .form-card {
    display: grid;
    gap: 22px;
    padding: clamp(24px, 4vw, 48px);
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 28px;
    box-shadow: 0 40px 80px -50px rgba(11, 31, 58, 0.35);
  }
  .form-title {
    font-size: var(--fs-h3);
  }
  .form-grid {
    display: grid;
    gap: 24px 20px;
  }
  @media (min-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
    .full {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }
  label,
  legend {
    font-weight: 600;
    line-height: 1.35;
  }
  legend {
    padding: 0;
    margin-bottom: 10px;
  }
  .hint {
    font-weight: 400;
    color: var(--steel);
  }
  input:not([type='checkbox']):not([type='radio']),
  textarea {
    width: 100%;
    min-height: 54px;
    padding: 14px 16px;
    border: 1.5px solid transparent;
    border-radius: 14px;
    background: var(--bone);
    color: var(--vein);
    font-size: 1.0625rem;
    transition:
      border-color var(--t-fast),
      background-color var(--t-fast),
      box-shadow var(--t-fast);
  }
  input:not([type='checkbox']):not([type='radio']):hover,
  textarea:hover {
    border-color: var(--rule);
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  input:not([type='checkbox']):not([type='radio']):focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--saline-text);
    background: var(--white);
    box-shadow: 0 0 0 4px rgba(31, 181, 234, 0.18);
  }
  [aria-invalid='true'] {
    border-color: var(--artery-text) !important;
    background: #fff6f5 !important;
  }

  /* Choice chips: real radios and checkboxes, styled as pills. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .choice {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }
  /* The real input stays on top so clicks always reach it. */
  .choice input,
  .segment-option input {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .choice-ui {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1.5px solid var(--rule);
    border-radius: var(--r-pill);
    background: var(--white);
    font-weight: 500;
    font-size: 0.9688rem;
    line-height: 1.25;
    transition:
      background-color var(--t-fast),
      border-color var(--t-fast),
      color var(--t-fast),
      transform var(--t-fast);
  }
  .choice:hover .choice-ui {
    border-color: #b9c9dc;
  }
  .choice input:checked + .choice-ui {
    border-color: var(--vein);
    background: var(--vein);
    color: var(--white);
  }
  .choice input:focus-visible + .choice-ui,
  .segment-option input:focus-visible + .segment-ui {
    outline: 3px solid var(--saline-text);
    outline-offset: 2px;
  }
  .choice input:active + .choice-ui {
    transform: scale(0.97);
  }
  .choice-check {
    display: none;
    color: var(--saline);
  }
  .choice input:checked + .choice-ui .choice-check {
    display: block;
  }

  /* Segmented control for the contact preference. */
  .segment {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    max-width: 420px;
    padding: 4px;
    border-radius: var(--r-pill);
    background: var(--bone);
  }
  .segment-option {
    position: relative;
    display: flex;
  }
  .segment-ui {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 44px;
    border-radius: var(--r-pill);
    font-weight: 600;
    font-size: 0.9688rem;
    color: var(--steel);
    transition:
      background-color var(--t-fast),
      color var(--t-fast),
      box-shadow var(--t-fast);
  }
  .segment-option input:checked + .segment-ui {
    background: var(--white);
    color: var(--vein);
    box-shadow: 0 4px 14px -4px rgba(11, 31, 58, 0.25);
  }
  .gotcha {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-row {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 64px;
    margin-top: 24px;
  }
  .submit-drop {
    position: absolute;
    left: 0;
    top: 50%;
    margin-top: -32px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  /* Success final state: the button has become a filled drop. */
  .submit-row.is-sent .submit {
    visibility: hidden;
  }
  .submit-row.is-sent .submit-drop {
    opacity: 1;
    visibility: visible;
  }
  .form-status {
    margin-top: 16px;
    font-weight: 600;
    min-height: 1.6em;
  }
  .form-status.ok {
    color: var(--vein);
  }
  .form-status.err {
    color: var(--artery-text);
  }
</style>

---
/** Home 6.2: one team for the line, the blood and the infusion. */
import { services, publicItems } from '../data/services';
import { withBase } from '../lib/url';

const linkText: Record<string, string> = {
  vascular: 'More on vascular access',
  transfusion: 'More on transfusion',
  infusion: 'More on infusion therapies',
};
---

<section id="services" class="section theme-light" data-thread="Services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="services-title">One team for the line, the blood and the infusion.</h2>
      <p class="lede">
        Most facilities call one vendor for a PICC, send residents out for a transfusion and juggle a
        third for IV therapy. DVATE handles all three at the bedside.
      </p>
    </div>
    <div class="panels">
      {
        services.map((s) => (
          <article class:list={['panel', `panel-${s.key}`]} aria-labelledby={`panel-${s.key}`}>
            <h3 id={`panel-${s.key}`}>{s.name}</h3>
            <p class="panel-summary">{s.summary}</p>
            <ul class="panel-list">
              {publicItems(s).map((item) => (
                <li>{item.label}</li>
              ))}
            </ul>
            <a class="text-link panel-link" href={withBase(s.route)}>
              {linkText[s.key]}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .panels {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 768px) {
    .panels {
      grid-template-columns: 1fr 1fr;
    }
    .panel-vascular {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1200px) {
    .panels {
      grid-template-columns: 1.55fr 1fr 1fr;
    }
    .panel-vascular {
      grid-column: auto;
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(24px, 3vw, 36px);
    background: var(--bone);
    border-radius: var(--r-panel);
    border-top: 6px solid transparent;
  }
  .panel-vascular {
    background: var(--vein);
    color: var(--white);
    --link: var(--saline);
    --link-hover: var(--white);
    --focus: var(--saline);
  }
  .panel-vascular .panel-summary {
    color: var(--mist-on-dark);
  }
  .panel-transfusion {
    border-top-color: var(--artery);
  }
  .panel h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
  }
  .panel-summary {
    color: var(--steel);
  }
  .panel-list {
    display: grid;
    gap: 10px 28px;
    padding: 16px 0 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .panel-vascular .panel-list {
    border-top-color: var(--rule-on-dark);
  }
  @media (min-width: 640px) {
    .panel-vascular .panel-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .panel-list li {
    position: relative;
    padding-left: 22px;
    line-height: 1.45;
  }
  .panel-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 3px;
    border-radius: 2px;
    background: var(--saline);
  }
  .panel-transfusion .panel-list li::before {
    background: var(--artery);
  }
  .panel-link {
    margin-top: auto;
    padding-top: 8px;
    align-self: flex-start;
  }
</style>

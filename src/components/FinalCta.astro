---
/**
 * Final call to action: a large dark card with the DVATE drop, which pulses once when
 * the card enters view (A1 final beat).
 */
import Button from './Button.astro';
import { primaryContact, telHref } from '../data/site';
import { routes } from '../lib/url';

interface Props {
  heading?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  theme?: 'light' | 'bone';
}
const {
  heading = 'Bring DVATE to your facility.',
  text = 'Tell us what your residents need and where you are. We will set up a time to talk through services, scheduling and pricing.',
  ctaLabel = 'Request service',
  ctaHref = routes.request,
  theme = 'bone',
} = Astro.props;

const dropPath = 'M22 8.5s-9.5 11.6-9.5 17.6a9.5 9.5 0 0 0 19 0C31.5 20.1 22 8.5 22 8.5z';
---

<section class:list={['fcta', `theme-${theme}`]} data-final-cta aria-labelledby="final-cta-title">
  <div class="wrap">
    <div class="fcta-card theme-dark" data-reveal>
      <span class="fcta-glow fcta-glow-a" aria-hidden="true"></span>
      <span class="fcta-glow fcta-glow-b" aria-hidden="true"></span>
      <div class="fcta-copy">
        <h2 id="final-cta-title">{heading}</h2>
        <p class="lede">{text}</p>
        <div class="btn-row">
          <Button href={ctaHref}>{ctaLabel}</Button>
          <Button href={telHref(primaryContact.phone)} variant="outline-light">Call {primaryContact.phone}</Button>
        </div>
      </div>
      <div class="fcta-art" aria-hidden="true">
        <span class="fcta-ring"></span>
        <span class="fcta-ring fcta-ring-2"></span>
        <svg class="fcta-drop" viewBox="10 6 24 32" width="120" height="160" focusable="false">
          <path d={dropPath} fill="#E5322D"></path>
          <path d="M17.6 24.5c.3-2.6 2-5.4 3.3-7.2" stroke="#FF9A94" stroke-width="1.6" stroke-linecap="round" fill="none"
          ></path>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .fcta {
    padding-block: clamp(56px, 7vw, 112px);
  }
  .fcta-card {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
    padding: clamp(36px, 6vw, 80px);
    border-radius: clamp(24px, 3vw, 36px);
    background: var(--vein-deep);
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 900px) {
    .fcta-card {
      grid-template-columns: 1fr auto;
      gap: 64px;
    }
  }
  .fcta-glow {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }
  .fcta-glow-a {
    width: 520px;
    height: 520px;
    right: -120px;
    top: -200px;
    background: radial-gradient(circle, rgba(31, 181, 234, 0.35), transparent 65%);
  }
  .fcta-glow-b {
    width: 420px;
    height: 420px;
    right: 80px;
    bottom: -260px;
    background: radial-gradient(circle, rgba(229, 50, 45, 0.3), transparent 65%);
  }
  .fcta-copy {
    display: grid;
    gap: 20px;
  }
  .fcta-copy h2 {
    max-width: 16ch;
  }
  .fcta-copy .lede {
    max-width: 40rem;
  }
  .fcta-copy .btn-row {
    margin-top: 8px;
  }

  .fcta-art {
    position: relative;
    display: none;
    place-items: center;
    width: 240px;
    height: 240px;
  }
  @media (min-width: 900px) {
    .fcta-art {
      display: grid;
    }
  }
  .fcta-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(31, 181, 234, 0.35);
    animation: ring 3.2s var(--ease-out) infinite;
  }
  .fcta-ring-2 {
    animation-delay: 1.6s;
  }
  @keyframes ring {
    0% {
      transform: scale(0.55);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.1);
      opacity: 0;
    }
  }
  .fcta-drop {
    position: relative;
    filter: drop-shadow(0 20px 40px rgba(229, 50, 45, 0.45));
    transform-origin: 50% 65%;
  }
  @media (prefers-reduced-motion: reduce) {
    .fcta-ring {
      animation: none;
      opacity: 0.4;
    }
  }
</style>

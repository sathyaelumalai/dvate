---
/** IV Mastery module grid and counters (A7). Final state: all tiles filled, counters at 17 and 43. */
import { site } from '../data/site';

interface Props {
  class?: string;
  /** false renders the final state with no scroll animation (Facility Briefing). */
  animate?: boolean;
  /** The CEU counter appears only on the Education page and the home page (spec Section 3). */
  showCeu?: boolean;
}
const { class: className, animate = true, showCeu = true } = Astro.props;
const tiles = Array.from({ length: site.moduleCount }, (_, i) => i + 1);
---

<div class:list={['modgrid', className]} data-modules={animate ? '' : undefined}>
  <div class="tiles" aria-hidden="true">
    {tiles.map((n) => (
      <span class="tile tabular">
        <span class="tile-fill" data-tile-fill />
        <span class="tile-n">{n}</span>
      </span>
    ))}
  </div>
  <div class="counters">
    <p class="counter">
      <span class="count tabular" aria-hidden="true" data-count={site.moduleCount} style={`--digits:${String(site.moduleCount).length}`}
        >{site.moduleCount}</span
      >
      <span class="visually-hidden">{site.moduleCount}</span>
      <span class="count-label">modules</span>
    </p>
    {
      site.showCeuCount && showCeu && (
        <p class="counter">
          <span class="count tabular" aria-hidden="true" data-count={site.ceuCount} style={`--digits:${String(site.ceuCount).length}`}>
            {site.ceuCount}
          </span>
          <span class="visually-hidden">{site.ceuCount}</span>
          <span class="count-label">free CEUs with the yearly subscription</span>
        </p>
      )
    }
  </div>
</div>

<style>
  .modgrid {
    display: grid;
    gap: 32px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    max-width: 420px;
  }
  .tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 12px;
    border: 1.5px solid var(--line-color);
    color: var(--vein);
    font-size: 0.875rem;
    font-weight: 600;
    overflow: hidden;
  }
  .tile-fill {
    position: absolute;
    inset: -2px;
    background: linear-gradient(150deg, #5fd0f5, var(--saline) 55%, #1597c7);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  .tile-n {
    position: relative;
  }
  .counters {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 480px) {
    .counters {
      grid-template-columns: auto 1fr;
      gap: 32px;
      align-items: start;
    }
  }
  .counter {
    display: grid;
    gap: 4px;
    max-width: 18rem;
  }
  .count {
    display: block;
    min-width: calc(var(--digits) * 1ch);
    font-size: clamp(3rem, 2.4rem + 2.5vw, 4.5rem);
    letter-spacing: -0.05em;
    font-weight: 640;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .count-label {
    color: var(--text-soft);
    line-height: 1.4;
  }
</style>

<script>
  import { runMotion } from '../lib/motion';
  runMotion(async () => {
    const { initModules } = await import('../scripts/motion/a7-modules');
    await initModules();
  });
</script>

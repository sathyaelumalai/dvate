---
import type { Faq } from '../data/details';

interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f) => (
      <details>
        <summary>
          <span>{f.q}</span>
          <svg class="faq-icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h12M10 4v12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
          </svg>
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line-color);
  }
  details {
    border-bottom: 1px solid var(--line-color);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 22px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    flex: none;
    color: var(--saline-text);
    transition: transform var(--t-fast);
  }
  details[open] .faq-icon {
    transform: rotate(45deg);
  }
  details p {
    padding-bottom: 24px;
    color: var(--text-soft);
  }
</style>

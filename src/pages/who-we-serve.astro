---
import PageLayout from '../layouts/PageLayout.astro';
import TransferCalculator from '../components/TransferCalculator.astro';
import Button from '../components/Button.astro';
import { facilityTypes } from '../data/details';
import { facilityIcons } from '../data/icons';
import { site } from '../data/site';
import { routes } from '../lib/url';
---

<PageLayout
  title="Who We Serve"
  description="DVATE brings bedside vascular access, transfusion and infusion care to skilled nursing, assisted living, LTACH and rehab, home health, hospice and physician groups."
  crumbs={[{ label: 'Who we serve' }]}
  heading="Who we serve"
  lede="DVATE works with the facilities and providers who care for residents and patients outside the hospital, and who want to keep them there."
  cta={{ theme: 'light' }}
>
  <section class="section theme-light" aria-labelledby="types-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="types-title">Built for the places residents live and recover.</h2>
        <p class="lede">Five kinds of care settings, one bedside team.</p>
      </div>
      <ul role="list" class="types" data-reveal-group>
        {
          facilityTypes.map((f, i) => (
            <li class:list={['type', { 'type-featured': i === 0 }]}>
              <span class="type-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="26"
                  height="26"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={facilityIcons[i]}
                />
              </span>
              <h3>{f.title}</h3>
              <p class="type-line">{f.line}</p>
              <p class="type-text">{f.text}</p>
              <ul role="list" class="type-chips" aria-label={`Services for ${f.title.toLowerCase()}`}>
                {f.services.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section theme-bone" aria-labelledby="calc-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="calc-title">What does sending residents out cost you?</h2>
        <p class="lede">Enter your own numbers. Nothing is filled in for you, and nothing you type leaves this page.</p>
      </div>
      <TransferCalculator id="wws-calc" />
    </div>
  </section>

  <section class="section theme-dark" aria-labelledby="coverage-title">
    <div class="wrap coverage">
      <h2 id="coverage-title">{site.coverageLine}</h2>
      <p class="lede">Tell us where your facility is and what your residents need, and we will tell you how we can serve your location.</p>
      <div class="btn-row">
        <Button href={routes.request}>Check service for your facility</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .types {
    display: grid;
    gap: 16px;
    margin: 0;
  }
  @media (min-width: 720px) {
    .types {
      grid-template-columns: repeat(2, 1fr);
    }
    .type-featured {
      grid-column: 1 / -1;
    }
  }
  .type {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(26px, 3vw, 36px);
    border: 1px solid var(--rule);
    border-radius: var(--r-panel);
    background: linear-gradient(180deg, var(--white), var(--bone));
    transition:
      border-color 250ms,
      box-shadow 250ms;
  }
  .type:hover {
    border-color: #b9c9dc;
    box-shadow: 0 30px 60px -36px rgba(11, 31, 58, 0.35);
  }
  .type-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 8px;
    border-radius: 16px;
    border: 1px solid var(--rule);
    background: var(--white);
    color: var(--saline-text);
  }
  .type h3 {
    font-size: 1.375rem;
  }
  .type-line {
    font-weight: 600;
    color: var(--saline-text);
    line-height: 1.4;
  }
  .type-text {
    color: var(--steel);
    font-size: 1rem;
  }
  .type-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding-top: 10px;
  }
  .type-chips li {
    padding: 6px 11px;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--white);
    font-size: 0.875rem;
    line-height: 1.3;
  }

  /* Featured card: the main buyer, larger and dark. */
  .type-featured {
    padding: clamp(32px, 4vw, 52px);
    border-color: transparent;
    background:
      radial-gradient(90% 70% at 100% 0%, rgba(31, 181, 234, 0.28), transparent 60%),
      radial-gradient(70% 60% at 0% 100%, rgba(229, 50, 45, 0.16), transparent 60%),
      var(--vein-deep);
    color: var(--white);
  }
  .type-featured .type-icon {
    margin-bottom: 20px;
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    color: var(--saline);
  }
  .type-featured h3 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
  }
  .type-featured .type-line {
    color: var(--saline);
    font-size: 1.125rem;
  }
  .type-featured .type-text {
    color: var(--mist-on-dark);
    font-size: 1.0625rem;
    max-width: 52ch;
  }
  .type-featured .type-chips {
    margin-top: 12px;
  }
  .type-featured .type-chips li {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    color: var(--white);
  }

  .coverage {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .coverage .lede {
    max-width: 40rem;
  }
</style>

---
import PageLayout from '../layouts/PageLayout.astro';
import ModuleGrid from '../components/ModuleGrid.astro';
import JourneySteps from '../components/JourneySteps.astro';
import { educationStepIcons, topicIcons } from '../data/icons';
import Button from '../components/Button.astro';
import { educationSteps, moduleContents, onsiteTopics } from '../data/content';
import { site } from '../data/site';
import { requestFor } from '../lib/url';

const description = site.showCeuCount
  ? `Online IV education through IV Mastery (${site.moduleCount} modules, competency checklists, ${site.ceuCount} free CEUs with a yearly subscription) and hands-on on-site training at your facility.`
  : `Online IV education through IV Mastery (${site.moduleCount} modules with competency checklists) and hands-on on-site training at your facility.`;
---

<PageLayout
  title="IV and Vascular Access Education for Nurses"
  description={description}
  crumbs={[{ label: 'Education' }]}
  heading="Education for the nurses who care for every line"
  lede="Online learning for your whole staff, hands-on training at your facility, or both."
  cta={{
    heading: 'Train your team with DVATE.',
    text: 'Ask about an IV Mastery subscription, on-site training or a combination for your facility.',
    ctaLabel: 'Ask about education',
    ctaHref: requestFor('Education'),
    theme: 'light',
  }}
>
  <section class="section theme-light" aria-labelledby="ivm-title">
    <div class="wrap split">
      <div class="split-intro">
        <h2 id="ivm-title">Online education through IV Mastery.</h2>
        <p class="lede">A yearly subscription that every nurse on your staff can use.</p>
        <p>
          IV Mastery takes your team through {site.moduleCount} modules. Each module contains:
        </p>
        <ul role="list" class="contents">
          {moduleContents.map((c) => <li>{c}</li>)}
        </ul>
        <p>
          After the modules, a designated preceptor at your facility runs a skills assessment. Nurses who pass earn a
          competency certificate.
        </p>
      </div>
      <ModuleGrid class="edu-grid" />
    </div>
  </section>

  <section class="section theme-bone" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title">How the online program works.</h2>
      </div>
      <JourneySteps steps={educationSteps} icons={educationStepIcons} label="How the online program works" />
    </div>
  </section>

  <section class="section theme-dark onsite" aria-labelledby="onsite-title">
    <span class="onsite-glow" aria-hidden="true"></span>
    <div class="wrap onsite-grid">
      <div class="onsite-intro">
        <h2 id="onsite-title">On-site education.</h2>
        <p class="lede">
          We bring our expertise to your facility, with sessions tailored to your operations.
        </p>
        <ul role="list" class="onsite-modes">
          <li>
            <span class="mode-dot" aria-hidden="true"></span>
            <span><strong>Classroom instruction</strong> at your facility</span>
          </li>
          <li>
            <span class="mode-dot mode-dot-red" aria-hidden="true"></span>
            <span><strong>Practical, hands-on training</strong> for your staff</span>
          </li>
        </ul>
        <div class="btn-row">
          <Button href={requestFor('Education')}>Ask about education</Button>
        </div>
      </div>
      <div class="topics">
        <p class="topics-label">Topics we can cover</p>
        <ul role="list" class="topic-list" data-reveal-group>
          {
            onsiteTopics.map((t, i) => (
              <li class="topic">
                <span class="topic-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={topicIcons[i]} />
                </span>
                <span class="topic-text">{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .contents {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  .contents li {
    position: relative;
    padding-left: 22px;
  }
  .contents li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 10px;
    height: 3px;
    border-radius: 2px;
    background: var(--saline);
  }
  .onsite {
    position: relative;
    overflow: hidden;
    background: var(--vein-deep);
  }
  .onsite-glow {
    position: absolute;
    right: -10%;
    top: -30%;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(31, 181, 234, 0.2), transparent 65%);
    filter: blur(60px);
    pointer-events: none;
  }
  .onsite-grid {
    position: relative;
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .onsite-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
  .onsite-intro {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .onsite-modes {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  .onsite-modes li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--mist-on-dark);
  }
  .onsite-modes strong {
    color: var(--white);
  }
  .mode-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--saline);
    box-shadow: 0 0 0 5px rgba(31, 181, 234, 0.15);
  }
  .mode-dot-red {
    background: var(--artery);
    box-shadow: 0 0 0 5px rgba(229, 50, 45, 0.15);
  }
  .topics {
    display: grid;
    gap: 14px;
  }
  .topics-label {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--mist-on-dark);
  }
  .topic-list {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .topic {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.04);
    transition:
      background-color 250ms,
      border-color 250ms,
      transform 250ms var(--ease-out);
  }
  .topic:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(31, 181, 234, 0.35);
    transform: translateX(4px);
  }
  .topic-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: linear-gradient(150deg, rgba(31, 181, 234, 0.3), rgba(31, 181, 234, 0.08));
    color: var(--saline);
  }
  .topic-text {
    min-width: 0;
    font-weight: 500;
  }
  @media (min-width: 1024px) {
    .edu-grid {
      padding-top: 12px;
    }
  }
</style>
